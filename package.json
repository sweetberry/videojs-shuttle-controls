{
  "name": "videojs-shuttle-controls",
  "version": "2.0.0",
  "description": "Adds shuttle controls(JKL controls) to video.js",
  "type": "module",
  "main": "./dist/videojs-shuttle-controls.cjs",
  "module": "./dist/videojs-shuttle-controls.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/videojs-shuttle-controls.min.js",
  "jsdelivr": "./dist/videojs-shuttle-controls.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/videojs-shuttle-controls.es.js",
      "require": "./dist/videojs-shuttle-controls.cjs",
      "default": "./dist/videojs-shuttle-controls.es.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "video.js",
    "videojs",
    "videojs-plugin",
    "shuttle",
    "jog",
    "JKL",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sweetberry/videojs-shuttle-controls.git"
  },
  "bugs": {
    "url": "https://github.com/sweetberry/videojs-shuttle-controls/issues"
  },
  "homepage": "https://github.com/sweetberry/videojs-shuttle-controls",
  "author": "sweetberry <pixel@sweetberry.com>",
  "license": "MIT",
  "peerDependencies": {
    "video.js": "^8.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "video.js": "^8.24.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
